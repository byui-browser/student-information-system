# Copy to .env (or export in your shell) to override defaults.

# Backend: address the API listens on.
SIS_ADDR=127.0.0.1:8080
# Backend: log filter, see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=info,tower_http=debug

# Desktop shell and MCP server: where the API lives.
SIS_API_URL=http://localhost:8080
# MCP server: bearer token, once authentication exists.
# SIS_API_TOKEN=

# Web client (Vite). Leave unset to use the dev-server proxy.
# VITE_SIS_API_URL=http://localhost:8080

# Mobile client (Expo). Android emulator: http://10.0.2.2:8080
# EXPO_PUBLIC_SIS_API_URL=http://localhost:8080
