{
  "name": "@sis/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server that exposes the SIS API as tools for AI assistants.",
  "type": "module",
  "bin": {
    "sis-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sis/api-client": "*",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
