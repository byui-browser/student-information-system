# Single source of truth for ignored files in this repository.
# Add new rules here rather than in nested .gitignore files.

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
# Build output (root workspace and the desktop shell's own workspace)
target/
# rustfmt backups
**/*.rs.bk
# MSVC debug info
*.pdb
# cargo-mutants output
**/mutants.out*/
# rustc internal compiler error dumps
rustc-ice-*.txt
# Coverage
*.profraw
*.profdata
lcov.info
tarpaulin-report.html

# ---------------------------------------------------------------------------
# Node / TypeScript (all clients)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Desktop (Tauri)
# ---------------------------------------------------------------------------
# Generated capability schemas
clients/desktop/src-tauri/gen/schemas/

# ---------------------------------------------------------------------------
# Mobile (Expo / React Native)
# ---------------------------------------------------------------------------
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
# Native projects are generated by `expo prebuild`; configure them in app.json.
clients/mobile/ios/
clients/mobile/android/
# Signing material
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ---------------------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Logs and local databases
# ---------------------------------------------------------------------------
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.sw?
*~
.DS_Store
Thumbs.db
